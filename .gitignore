# O Google Drive de mentira e a pasta de origem que a bateria monta. Reproduzivel
# com scripts/monta-lab.sh, e pesa, entao fica fora do repositorio.
.lab/
.lab.velho.*/

# Artefato que um teste a mao pode deixar na raiz. Nunca versionar: o relatorio
# lista nomes de arquivo de quem rodou, e o registro diz para onde cada um foi.
RELATORIO-*.txt
registro.tsv
backup-*.log
rclone.conf
rclone.conf.antes-*

# Nunca, em nenhuma hipotese
*.pem
*.key
id_rsa
id_rsa.*
.env
.env.*
*.tar.gz
*.gpg
*.enc

# Rascunho da maquina dentro do graphify-out. O resto do graphify-out E
# versionado e entra no commit da tarefa: ele e o mapa do repositorio, nao
# sobra de build, e nao entra em nenhuma limpeza de disco.
graphify-out/cache/
graphify-out/.graphify_detect.json
graphify-out/.graphify_extract.json
graphify-out/.graphify_root
graphify-out/.graphify_python
